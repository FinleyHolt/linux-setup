// Neovim's and Ghostty's keys in Zed.
//   Neovim (nvim/init.lua, toggleterm): Ctrl-P the file panel like Neo-tree,
//   Ctrl-F find files like Telescope, Ctrl-L search the project like live grep,
//   Ctrl-\ the terminal.
//   gitsigns (nvim/lua/plugins/gitsigns.lua): ]h and [h between hunks; Space g
//   then s stage, r reset, p preview, b blame, d diff.
//   Ghostty (its defaults and ghostty/config): Ctrl-Shift-T opens a terminal as
//   a tab beside the files, from anywhere; Ctrl-Alt-arrows move between splits,
//   files or terminals. In a terminal: Ctrl-Tab and Ctrl-Shift-Tab between tabs,
//   Ctrl-Shift-O split right, Ctrl-Shift-E split down, Ctrl-Shift-W close,
//   Shift-Enter a newline (for Claude Code).
[
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "ctrl-p": "project_panel::ToggleFocus",
      "ctrl-f": "file_finder::Toggle",
      "ctrl-l": "pane::DeploySearch",
      "] h": "editor::GoToHunk",
      "[ h": "editor::GoToPreviousHunk",
      "space g s": "git::ToggleStaged",
      "space g r": "git::Restore",
      "space g p": "editor::ToggleSelectedDiffHunks",
      "space g b": "editor::BlameHover",
      "space g d": "git::Diff",
      "ctrl-alt-left": "workspace::ActivatePaneLeft",
      "ctrl-alt-right": "workspace::ActivatePaneRight",
      "ctrl-alt-up": "workspace::ActivatePaneUp",
      "ctrl-alt-down": "workspace::ActivatePaneDown",
    },
  },
  {
    // Zed's Editor context binds Ctrl-\ to split right; this wins over it
    "context": "Editor",
    "bindings": {
      "ctrl-\\": "terminal_panel::Toggle",
    },
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "ctrl-p": "workspace::ToggleLeftDock",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-\\": "terminal_panel::Toggle",
      "ctrl-shift-t": "workspace::NewCenterTerminal",
      "ctrl-alt-left": "workspace::ActivatePaneLeft",
      "ctrl-alt-right": "workspace::ActivatePaneRight",
      "ctrl-alt-up": "workspace::ActivatePaneUp",
      "ctrl-alt-down": "workspace::ActivatePaneDown",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "shift-enter": ["terminal::SendText", "\u001b\r"],
      "ctrl-shift-t": "workspace::NewCenterTerminal",
      "ctrl-tab": "pane::ActivateNextItem",
      "ctrl-shift-tab": "pane::ActivatePreviousItem",
      "ctrl-shift-o": "pane::SplitRight",
      "ctrl-shift-e": "pane::SplitDown",
      "ctrl-alt-left": "workspace::ActivatePaneLeft",
      "ctrl-alt-right": "workspace::ActivatePaneRight",
      "ctrl-alt-up": "workspace::ActivatePaneUp",
      "ctrl-alt-down": "workspace::ActivatePaneDown",
    },
  },
]
