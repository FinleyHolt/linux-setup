// Neovim's and Ghostty's keys in Zed.
//   Neovim (nvim/init.lua, toggleterm): Ctrl-P the file panel like Neo-tree,
//   Ctrl-F find files like Telescope, Ctrl-L search the project like live grep,
//   Ctrl-\ the terminal.
//   gitsigns (nvim/lua/plugins/gitsigns.lua): ]h and [h between hunks; Space g
//   then s stage, r reset, p preview, b blame, d diff.
//   Ghostty (its defaults and ghostty/config): Ctrl-Shift-T opens a terminal as
//   a tab beside the files, from anywhere; Ctrl-Shift-O and Ctrl-Shift-E open a
//   terminal in a new split to the right of or below the active pane, from a
//   file, a terminal, or the file or git panel, and as the first tab when no
//   tabs are open; Ctrl-Alt-arrows move between splits, files or terminals. In
//   a terminal: Ctrl-Tab and Ctrl-Shift-Tab between tabs, Ctrl-Shift-W close,
//   Shift-Enter a newline (for Claude Code).
//   Projects: Ctrl-Alt-O the recent projects, local and remote; Ctrl-Alt-Shift-O
//   the remote list (the Thor's ~/Github, in settings.json). Vim mode takes
//   Ctrl-R for redo, so the recent projects need a key of their own.
//   Ctrl-Shift-N, Zed's new window, opens the remote list first; the project
//   picked there opens in the new window.
[
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "ctrl-p": "project_panel::ToggleFocus",
      "ctrl-f": "file_finder::Toggle",
      "ctrl-l": "pane::DeploySearch",
      "] h": "editor::GoToHunk",
      "[ h": "editor::GoToPreviousHunk",
      "space g s": "git::ToggleStaged",
      "space g r": "git::Restore",
      "space g p": "editor::ToggleSelectedDiffHunks",
      "space g b": "editor::BlameHover",
      "space g d": "git::Diff",
      "ctrl-alt-left": "workspace::ActivatePaneLeft",
      "ctrl-alt-right": "workspace::ActivatePaneRight",
      "ctrl-alt-up": "workspace::ActivatePaneUp",
      "ctrl-alt-down": "workspace::ActivatePaneDown",
    },
  },
  {
    // Zed's Editor context binds Ctrl-\ to split right; this wins over it
    "context": "Editor",
    "bindings": {
      "ctrl-\\": "terminal_panel::Toggle",
    },
  },
  {
    // Ghostty's split keys open a terminal in a new split, from a file or
    // anything else in a pane (an image, a settings page, a search bar): F13 or
    // F14 makes the split, empty, then Ctrl-Shift-T opens the terminal in it.
    // SendKeystrokes draws a frame between the two, and that frame is what
    // makes the new split the active pane; an action::Sequence draws none and
    // relied on the terminal starting after the next frame. Replaces Zed's
    // outline (Ctrl-Shift-O) and reveal-in-file-panel (Ctrl-Shift-E) in files.
    "context": "(Editor && mode == full) || (Pane && !EmptyPane)",
    "bindings": {
      "ctrl-shift-o": ["workspace::SendKeystrokes", "f13 ctrl-shift-t"],
      "ctrl-shift-e": ["workspace::SendKeystrokes", "f14 ctrl-shift-t"],
    },
  },
  {
    // F13 and F14 are not on the keyboard; they name the empty splits for the
    // keys above.
    "context": "Pane",
    "bindings": {
      "f13": ["pane::SplitRight", { "mode": "EmptyPane" }],
      "f14": ["pane::SplitDown", { "mode": "EmptyPane" }],
    },
  },
  {
    // With no tabs open, either key opens the first terminal as a tab.
    "context": "EmptyPane",
    "bindings": {
      "ctrl-shift-o": "workspace::NewCenterTerminal",
      "ctrl-shift-e": "workspace::NewCenterTerminal",
    },
  },
  {
    // A click on a file in the file or git panel opens it but leaves the focus
    // in the panel. From there, the split keys first press the panel's own key
    // back to the active pane (Escape in the file panel under vim mode,
    // Ctrl-Shift-G in the git panel), then the split key in that pane.
    "context": "ProjectPanel",
    "bindings": {
      "ctrl-p": "workspace::ToggleLeftDock",
      "ctrl-shift-o": ["workspace::SendKeystrokes", "escape ctrl-shift-o"],
      "ctrl-shift-e": ["workspace::SendKeystrokes", "escape ctrl-shift-e"],
    },
  },
  {
    "context": "GitPanel",
    "bindings": {
      "ctrl-shift-o": ["workspace::SendKeystrokes", "ctrl-shift-g ctrl-shift-o"],
      "ctrl-shift-e": ["workspace::SendKeystrokes", "ctrl-shift-g ctrl-shift-e"],
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-o": "projects::OpenRecent",
      "ctrl-alt-shift-o": "projects::OpenRemote",
      // Zed's new window opens empty and local; this one asks which remote
      // first, and create_new_window puts the picked project in a new window.
      "ctrl-shift-n": ["projects::OpenRemote", { "from_existing_connection": false, "create_new_window": true }],
      "ctrl-\\": "terminal_panel::Toggle",
      "ctrl-shift-t": "workspace::NewCenterTerminal",
      "ctrl-alt-left": "workspace::ActivatePaneLeft",
      "ctrl-alt-right": "workspace::ActivatePaneRight",
      "ctrl-alt-up": "workspace::ActivatePaneUp",
      "ctrl-alt-down": "workspace::ActivatePaneDown",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "shift-enter": ["terminal::SendText", "\u001b\r"],
      "ctrl-shift-t": "workspace::NewCenterTerminal",
      "ctrl-tab": "pane::ActivateNextItem",
      "ctrl-shift-tab": "pane::ActivatePreviousItem",
      "ctrl-shift-o": "pane::SplitRight",
      "ctrl-shift-e": "pane::SplitDown",
      "ctrl-alt-left": "workspace::ActivatePaneLeft",
      "ctrl-alt-right": "workspace::ActivatePaneRight",
      "ctrl-alt-up": "workspace::ActivatePaneUp",
      "ctrl-alt-down": "workspace::ActivatePaneDown",
    },
  },
]
