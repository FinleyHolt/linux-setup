# NOPASSWD for the exact NPS GlobalProtect VPN bring-up / heal commands that
# net/nps-vpn.sh runs non-interactively. Scoped to specific binary + argument
# vectors only; no general ip/gpclient privilege is granted. The
# `ip link set tun0 mtu NNNN` entry is the path-MTU black-hole fix (see
# net/nps-vpn.md); the four [0-9] globs bound it to tun0 and a 4-digit MTU.
# The --no-dtls vectors are the ones the script prefers: an HTTPS-only tunnel
# rides out an underlay blip on the same session where ESP's fallback exits
# on its first miss (net/nps-vpn.md, "Underlay blip"). The script reads this
# file's grants off `sudo -l` and dials the best one it finds, so an older
# install of this file still dials -- without that protection.
#
# One add/del pair per split-tunnel prefix, matching NET_SPLIT_ROUTES in
# net/nps-vpn.sh: 172.20.0.0/16 is campus + hamming, 10.0.248.0/24 is the
# ai.nps.edu DGX GB300. A sudoers glob cannot follow a shell variable, so each
# prefix is spelled out here -- and a prefix the script asserts but this file
# omits fails SILENTLY, because the script runs `sudo -n ... 2>/dev/null`.
#
# One-time install (run once, the only interactive sudo needed):
#   sudo install -o root -g root -m 0440 \
#     net/sudoers.d/nps-vpn /etc/sudoers.d/nps-vpn
#   sudo visudo -cf /etc/sudoers.d/nps-vpn         # must print "parsed OK"
#
# Migrating from the old project drop-in? Remove it afterwards:
#   sudo rm -f /etc/sudoers.d/drone-nps-vpn

Cmnd_Alias NPS_VPN = \
    /usr/bin/gpclient --fix-openssl connect vpn.nps.edu, \
    /usr/bin/gpclient connect vpn.nps.edu, \
    /usr/bin/gpclient --fix-openssl connect vpn.nps.edu --cookie-cache, \
    /usr/bin/gpclient connect vpn.nps.edu --cookie-cache, \
    /usr/bin/gpclient --fix-openssl connect vpn.nps.edu --cookie-cache --browser remote, \
    /usr/bin/gpclient --fix-openssl connect vpn.nps.edu --cookie-cache --reconnect-timeout [0-9][0-9][0-9][0-9], \
    /usr/bin/gpclient --fix-openssl connect vpn.nps.edu --cookie-cache --reconnect-timeout [0-9][0-9][0-9][0-9] --browser remote, \
    /usr/bin/gpclient --fix-openssl connect vpn.nps.edu --cookie-cache --reconnect-timeout [0-9][0-9][0-9][0-9] --no-dtls, \
    /usr/bin/gpclient --fix-openssl connect vpn.nps.edu --cookie-cache --reconnect-timeout [0-9][0-9][0-9][0-9] --no-dtls --browser remote, \
    /usr/bin/gpclient disconnect, \
    /usr/bin/ip link set tun0 mtu [0-9][0-9][0-9][0-9], \
    /usr/bin/ip route del default dev tun0, \
    /usr/bin/ip route add 172.20.0.0/16 dev tun0, \
    /usr/bin/ip route del 172.20.0.0/16 dev tun0, \
    /usr/bin/ip route add 10.0.248.0/24 dev tun0, \
    /usr/bin/ip route del 10.0.248.0/24 dev tun0, \
    /usr/bin/resolvectl domain tun0 ~nps.edu

finley ALL=(root) NOPASSWD: NPS_VPN
